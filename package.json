{
  "name": "video-translation-workflow",
  "productName": "影译工坊",
  "private": true,
  "version": "0.2.41",
  "description": "Local-first Windows desktop workflow for Chinese-to-English video translation, subtitle review, AI dubbing, and final MP4 rendering",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "video-translation",
    "ai-dubbing",
    "subtitle-translation",
    "chinese-to-english",
    "whisperx",
    "paddleocr",
    "voxcpm",
    "ffmpeg",
    "electron",
    "local-first"
  ],
  "homepage": "https://github.com/GitYohoo/Video_Translation_Workflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitYohoo/Video_Translation_Workflow.git"
  },
  "bugs": {
    "url": "https://github.com/GitYohoo/Video_Translation_Workflow/issues"
  },
  "author": "影译工坊",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\ensure_dev_ports_free.ps1 && concurrently \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run desktop:patch-builder && npm run build && electron-builder --win nsis portable && npm run desktop:verify",
    "desktop:patch-builder": "node .\\scripts\\patch_electron_builder_portable.mjs",
    "desktop:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\verify_desktop_package.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\package_release.ps1",
    "test:node": "node --test tests/*.test.mjs",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.4",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.yingyigongfang.desktop",
    "productName": "影译工坊",
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "scripts/**/*",
      "build/icon.png"
    ],
    "compression": "normal",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "scripts/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "影译工坊",
      "artifactName": "影译工坊-安装版-${version}-${arch}.${ext}"
    },
    "portable": {
      "unpackDirName": false,
      "artifactName": "影译工坊-便携版-${version}-${arch}.${ext}"
    }
  }
}
